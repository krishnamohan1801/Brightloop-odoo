DB_URL=jdbc:postgresql://localhost:5432/brightloop
DB_USERNAME=postgres
DB_PASSWORD=replace_with_local_database_password

# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_BASE64_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRATION_MS=3600000

SPRING_MAIL_USERNAME=yourgmail@gmail.com
SPRING_MAIL_APP_PASSWORD=replace_with_google_app_password
FRONTEND_URL=http://localhost:5173

# Optional: first local administrator bootstrap; clear after first use.
BRIGHTLOOP_ADMIN_NAME=Brightloop Admin
BRIGHTLOOP_ADMIN_EMAIL=admin@example.com
BRIGHTLOOP_ADMIN_PASSWORD=ChangeThisImmediately123!
